#!/bin/bash
# a16-whine-tweaks on|off: ear-judged coil-whine reductions (2026-09-26 morning, not mic-verified: the room was
# not quiet enough). Applied together: NVMe PCIe link forced to Gen1, Wi-Fi PCIe link forced to Gen1, the two
# 4.4 GHz clusters (cpu6-17) taken offline, remaining cluster's clock fixed (min=max, one voltage), runtime PM
# forced on for every USB/PCI/platform device except the GPU, the unused compute DSP stopped. Config:
# /etc/default/a16-whine. Costs: SSD sequential throughput capped near 0.9 GB/s (Gen1 x4), Wi-Fi capped near
# 2 Gbit/s (Gen1 x1), ~1/3 of the multi-thread performance and the highest-clocked cores gone, everything runs
# at the fixed clock, peripherals never enter their low-power modes (a few hundred mW).
NVME_GEN=${NVME_GEN:-1}; WIFI_GEN=${WIFI_GEN:-1}; OFFLINE_CPUS=${OFFLINE_CPUS:-6-17}
MIN_KHZ=${MIN_KHZ:-3609600}; MAX_KHZ=${MAX_KHZ:-3609600}; RUNTIME_PM=${RUNTIME_PM:-on}; STOP_CDSP=${STOP_CDSP:-1}
NVME_GEN_STOCK=4; WIFI_GEN_STOCK=3; MIN_KHZ_STOCK=355200; RPM_SAVED=/run/a16-whine-rpm
mode=${1:-on}
log(){ logger -t a16-whine-tweaks "$*"; echo "$*"; }
# retrain a root port's link at PCIe generation $2 (LnkCtl2 target speed + LnkCtl retrain bit)
setgen(){ local ep=$1 gen=$2 rp v c
  rp=$(basename "$(dirname "$(readlink -f "$ep")")")
  v=$(setpci -s "$rp" CAP_EXP+0x30.w) || return 1
  setpci -s "$rp" CAP_EXP+0x30.w=$(printf %04x $(( (0x$v & ~0xF) | gen )))
  c=$(setpci -s "$rp" CAP_EXP+0x10.w); setpci -s "$rp" CAP_EXP+0x10.w=$(printf %04x $(( 0x$c | 0x20 ))); sleep 1
  log "$(basename "$ep") via $rp: $(cat "$ep/current_link_speed") x$(cat "$ep/current_link_width")"; }
expand(){ local out= r; for r in ${1//,/ }; do case $r in *-*) out="$out $(seq ${r%-*} ${r#*-})";; *) out="$out $r";; esac; done; echo $out; }
for i in $(seq 20); do ls /sys/bus/pci/devices/*/class >/dev/null 2>&1 && break; sleep 1; done
sync
for d in /sys/bus/pci/devices/*; do
  case "$(cat "$d/class" 2>/dev/null)" in
    0x010802) [ "$mode" = on ] && setgen "$d" "$NVME_GEN" || setgen "$d" "$NVME_GEN_STOCK" ;;
    0x028000) [ "$mode" = on ] && setgen "$d" "$WIFI_GEN" || setgen "$d" "$WIFI_GEN_STOCK" ;;
  esac
done
if [ "$mode" = on ]; then
  for c in $(expand "$OFFLINE_CPUS"); do echo 0 > /sys/devices/system/cpu/cpu$c/online 2>/dev/null; done
  for p in /sys/devices/system/cpu/cpufreq/policy*; do echo "$MAX_KHZ" > "$p/scaling_max_freq" 2>/dev/null; echo "$MIN_KHZ" > "$p/scaling_min_freq" 2>/dev/null; done
  if [ "$RUNTIME_PM" = on ]; then : > $RPM_SAVED
    for f in /sys/bus/{usb,pci,platform}/devices/*/power/control; do case $f in *gpu*) continue;; esac
      [ "$(cat "$f" 2>/dev/null)" = auto ] && echo on > "$f" 2>/dev/null && echo "$f" >> $RPM_SAVED; done
    log "runtime PM forced on for $(wc -l < $RPM_SAVED) devices"; fi
  [ "$STOP_CDSP" = 1 ] && for r in /sys/class/remoteproc/*; do [ "$(cat $r/name)" = cdsp ] && echo stop > $r/state 2>/dev/null && log "cdsp stopped"; done
else
  for c in $(expand "$OFFLINE_CPUS"); do echo 1 > /sys/devices/system/cpu/cpu$c/online 2>/dev/null; done
  for p in /sys/devices/system/cpu/cpufreq/policy*; do cat "$p/cpuinfo_max_freq" > "$p/scaling_max_freq" 2>/dev/null; echo "$MIN_KHZ_STOCK" > "$p/scaling_min_freq" 2>/dev/null; done
  [ -e $RPM_SAVED ] && while read -r f; do echo auto > "$f" 2>/dev/null; done < $RPM_SAVED && rm -f $RPM_SAVED
  for r in /sys/class/remoteproc/*; do [ "$(cat $r/name)" = cdsp ] && echo start > $r/state 2>/dev/null; done
fi
log "cpus online: $(cat /sys/devices/system/cpu/online); freq min/max: $(cat /sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq)/$(cat /sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq) ($mode)"
