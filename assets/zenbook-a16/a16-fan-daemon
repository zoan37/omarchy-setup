#!/bin/bash
# a16-fan-daemon v2: smooth custom fan curve for the ASUS Zenbook A16 via the EC mailbox (manual mode).
# Input: hottest CPU zone, exponentially smoothed (time constant ~20 s at a 3 s period), so short bursts
# are absorbed. Turn-on needs the smoothed value above ON_C; once on, stays on MIN_ON_S and turns off only
# after the smoothed value has been below OFF_C for OFF_HOLD_S. Duty changes are slew-limited (UP_STEP /
# DOWN_STEP per period) for a gradual rise and a slow fade. FAST_C bypasses smoothing (instant ramp).
# Safety: temp >= TRIP_C or any I2C failure -> controller back to automatic and exit (systemd restarts).
ON_C=${ON_C:-50000}; OFF_C=${OFF_C:-45000}; FAST_C=${FAST_C:-70000}; TRIP_C=${TRIP_C:-85000}
MIN_ON_S=${MIN_ON_S:-90}; OFF_HOLD_S=${OFF_HOLD_S:-60}; PERIOD=${PERIOD:-3}
UP_STEP=${UP_STEP:-6}; DOWN_STEP=${DOWN_STEP:-3}; ALPHA_PCT=${ALPHA_PCT:-15}   # EMA weight of the new sample, percent
PWM_MIN=${PWM_MIN:-75}; BUS=${BUS:-9}
rb(){ i2ctransfer -y $BUS w3@0x5b 0x10 $1 $2 >/dev/null 2>&1 || return 1; v=$(i2ctransfer -y $BUS w1@0x5b 0x11 r1@0x5b 2>/dev/null) || return 1; echo $((v)); }
wb(){ i2ctransfer -y $BUS w3@0x5b 0x10 $1 $2 >/dev/null 2>&1 || return 1; i2ctransfer -y $BUS w2@0x5b 0x11 $3 >/dev/null 2>&1; }
settle(){ local i; for i in $(seq 1 75); do [ "$(rb 0xc4 0x30)" = 0 ] && return 0; sleep 0.02; done; return 1; }
eccw(){ settle && wb 0xc4 0x31 $2 && wb 0xc4 0x32 $3 && wb 0xc4 0x30 $1 && settle; }
set_auto(){ eccw 0x01 0x82 0x00; }
set_pwm(){ local p=$(printf 0x%02x $1); eccw 0x01 0x8c 0x00 && eccw 0x01 0x8a $p && eccw 0x01 0x8c 0x01 && eccw 0x01 0x8a $p; }
maxtemp(){ local m=0 z t; for z in /sys/class/thermal/thermal_zone*; do case "$(cat $z/type 2>/dev/null)" in cpu*) t=$(cat $z/temp 2>/dev/null) || continue; [ "$t" -gt "$m" ] && m=$t;; esac; done; echo $m; }
curve(){ # smoothed temp (mC) -> target pwm: PWM_MIN at ON_C, 120 at 65C, 200 at 80C, 220 at TRIP
  local t=$1
  if   [ $t -le $ON_C ];  then echo $PWM_MIN
  elif [ $t -lt 65000 ];  then echo $(( PWM_MIN + (t-ON_C)*(120-PWM_MIN)/(65000-ON_C) ))
  elif [ $t -lt 80000 ];  then echo $(( 120 + (t-65000)*80/15000 ))
  else                          echo $(( 200 + (t-80000)*20/5000 )); fi
}
release(){ set_auto; logger -t a16-fan "released to automatic ($1)"; exit ${2:-0}; }
trap 'release stop 0' TERM INT
eccw 0x01 0x82 0x02 || { logger -t a16-fan "cannot enter manual mode"; set_auto; exit 1; }
logger -t a16-fan "v2 manual mode on: on>${ON_C} off<${OFF_C} fast>${FAST_C} trip>=${TRIP_C} minon=${MIN_ON_S}s offhold=${OFF_HOLD_S}s"
ema=$(maxtemp); fan_on=0; pwm=0; on_since=0; below_since=0; now=0
set_pwm 0 || release "i2c" 1
while :; do
  t=$(maxtemp); now=$((now+PERIOD))
  [ "$t" -ge "$TRIP_C" ] && release "trip $t" 1
  ema=$(( (ema*(100-ALPHA_PCT) + t*ALPHA_PCT) / 100 ))
  if [ $fan_on -eq 0 ]; then
    if [ "$ema" -gt "$ON_C" ] || [ "$t" -ge "$FAST_C" ]; then fan_on=1; on_since=$now; below_since=0; logger -t a16-fan "on (t=$t ema=$ema)"; fi
  else
    if [ "$ema" -lt "$OFF_C" ]; then [ $below_since -eq 0 ] && below_since=$now; else below_since=0; fi
    if [ $below_since -ne 0 ] && [ $((now-below_since)) -ge $OFF_HOLD_S ] && [ $((now-on_since)) -ge $MIN_ON_S ]; then fan_on=0; logger -t a16-fan "off (t=$t ema=$ema)"; fi
  fi
  if [ $fan_on -eq 1 ]; then
    if [ "$t" -ge "$FAST_C" ]; then target=$(curve $t); else target=$(curve $ema); fi
    if [ $target -gt $pwm ]; then step=$UP_STEP; [ "$t" -ge "$FAST_C" ] && step=40; new=$((pwm+step)); [ $new -gt $target ] && new=$target; [ $new -lt $PWM_MIN ] && new=$PWM_MIN
    elif [ $target -lt $pwm ]; then new=$((pwm-DOWN_STEP)); [ $new -lt $target ] && new=$target
    else new=$pwm; fi
  else
    if [ $pwm -gt $PWM_MIN ]; then new=$((pwm-DOWN_STEP)); [ $new -lt $PWM_MIN ] && new=$PWM_MIN; else new=0; fi   # fade to minimum, then off
  fi
  if [ "$new" != "$pwm" ]; then set_pwm $new || release "i2c write failed" 1; pwm=$new; logger -t a16-fan "t=$t ema=$ema pwm=$pwm"; fi
  sleep $PERIOD
done
