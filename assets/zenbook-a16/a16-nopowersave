#!/bin/bash
# a16-nopowersave: keep the Zenbook A16's peripheral power domains awake at idle. Reduces coil whine
# (found 2026-09-26). Costs some idle power. "off" restores the kernel defaults until the next boot.
mode=${1:-on}
case $mode in
  on)  pol=performance; ctl=on ;;
  off) pol=default; ctl=auto ;;
  *) echo "usage: $0 on|off"; exit 1 ;;
esac
echo $pol > /sys/module/pcie_aspm/parameters/policy 2>/dev/null
for d in /sys/bus/pci/devices/*/power/control /sys/bus/usb/devices/*/power/control \
         /sys/bus/platform/devices/*/power/control /sys/bus/i2c/devices/*/power/control \
         /sys/bus/spmi/devices/*/power/control; do echo $ctl > "$d" 2>/dev/null; done
echo 0 > /sys/module/nvme_core/parameters/default_ps_max_latency_us 2>/dev/null   # no NVMe APST for new probes
logger -t a16-nopowersave "$mode (pcie_aspm=$pol, runtime pm=$ctl)"
