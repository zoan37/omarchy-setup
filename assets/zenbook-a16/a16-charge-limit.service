[Unit]
Description=A16: hold the battery at 75-80% (always plugged in)
[Service]
Type=oneshot
ExecStartPre=/bin/sleep 20
ExecStart=/bin/sh -c "b=/sys/class/power_supply/qcom-battmgr-bat; echo 80 > $b/charge_control_end_threshold; echo 75 > $b/charge_control_start_threshold"
[Install]
WantedBy=multi-user.target
