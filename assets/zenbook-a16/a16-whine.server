# /etc/default/a16-whine: SERVER profile (2026-10-24). The laptop runs headless as a server, so coil whine no longer
# matters; heat and noise are kept down with a frequency cap instead. Desktop profile: a16-whine.bak-desktop-*.
# Values only on assignment lines (systemd keeps inline comments as part of the value).
# PCIe generation: NVMe and Wi-Fi at Gen1 (Gen4 NVMe dropped off the bus under load; Wi-Fi at Gen3 + runtime PM dropped off the network, 2026-10-24)
NVME_GEN=1
WIFI_GEN=1
# all 18 CPUs online ("none" because an empty value falls back to the script default)
OFFLINE_CPUS=none
# scale freely up to a 2.4 GHz cap: under sustained all-core load it throttled to ~2.4 GHz at 93-95 C anyway
MIN_KHZ=355200
MAX_KHZ=2400000
# keep devices awake (runtime PM forced on): the Wi-Fi card dropped off with runtime PM allowed
RUNTIME_PM=on
# the compute DSP stays stopped (unused): 1|0
STOP_CDSP=1
