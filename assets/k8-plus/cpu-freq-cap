#!/bin/sh
# Cap every CPU core at MAX_MHZ (default 4000). The 8845HS boosts to 5.1 GHz stock.
MAX_MHZ=${MAX_MHZ:-4000}
for c in /sys/devices/system/cpu/cpu*/cpufreq/scaling_max_freq; do
  echo $((MAX_MHZ * 1000)) > $c
done
echo "scaling_max_freq=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq)"
