[Unit]
Description=Beelink SER8: coil-whine reduction (PCIe links out of L1, C3 idle off)
After=multi-user.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-/etc/default/ser8-whine
ExecStart=/usr/local/bin/ser8-whine-tweaks on
ExecStop=/usr/local/bin/ser8-whine-tweaks off

[Install]
WantedBy=multi-user.target
