#!/bin/sh
# CPU boost off (4.5 GHz base clock) to keep the tower well under the circuit limit. "on" restores boost.
case "${1:-off}" in on) v=1 ;; *) v=0 ;; esac
echo $v > /sys/devices/system/cpu/cpufreq/boost
echo "cpu boost: $(cat /sys/devices/system/cpu/cpufreq/boost)  max $(( $(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq) / 1000 )) MHz"
