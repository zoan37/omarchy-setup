#!/bin/sh
# Cap the Strix Halo iGPU (amdgpu) shader clock. Usage: x3-gpu-clock-cap [MHz|off]   (default 2000)
# Stock range is 600-2900 MHz. Decode on Strix Halo is memory-bound, so a cap cuts power far more than speed.
set -eu
cap=${1:-2000}
for d in /sys/class/drm/card*/device; do
  [ -f "$d/pp_od_clk_voltage" ] && [ "$(basename "$(readlink -f "$d/driver")")" = amdgpu ] || continue
  if [ "$cap" = off ]; then
    echo "s 1 2900" > "$d/pp_od_clk_voltage"; echo c > "$d/pp_od_clk_voltage"; echo auto > "$d/power_dpm_force_performance_level"
  else
    echo manual > "$d/power_dpm_force_performance_level"
    echo "s 1 $cap" > "$d/pp_od_clk_voltage"; echo c > "$d/pp_od_clk_voltage"
  fi
  echo "$d: $(sed -n 3p "$d/pp_od_clk_voltage" | tr -s ' ')"
done
